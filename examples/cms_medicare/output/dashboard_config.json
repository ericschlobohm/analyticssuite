{
  "id": "cms_medicare_gaf",
  "name": "Medicare GAF & Fee Schedule Payments",
  "description": "CY2022-CY2026 Medicare GAF by state/locality and base payments by procedure",
  "layout": "grid",
  "charts": [
    {
      "id": "map_gaf",
      "title": "GAF % change by state",
      "type": "heatmap",
      "query": "SELECT STATE, PCT_CHANGE FROM CMS_GAF_STATE_CHANGE",
      "x_column": "STATE",
      "y_column": "PCT_CHANGE",
      "dimensions": [],
      "measures": [],
      "filters": {},
      "color_scheme": "default",
      "height": 400,
      "width": 500,
      "aggregation": null,
      "sort_by": null,
      "show_legend": true,
      "show_grid": true,
      "refresh_interval": 300,
      "description": ""
    },
    {
      "id": "bar_extremes",
      "title": "Largest/smallest GAF change",
      "type": "bar",
      "query": "SELECT STATE, PCT_CHANGE FROM CMS_GAF_STATE_CHANGE QUALIFY ROW_NUMBER() OVER (ORDER BY PCT_CHANGE DESC) <= 10 OR ROW_NUMBER() OVER (ORDER BY PCT_CHANGE) <= 10",
      "x_column": "PCT_CHANGE",
      "y_column": "STATE",
      "dimensions": [],
      "measures": [],
      "filters": {},
      "color_scheme": "default",
      "height": 400,
      "width": 500,
      "aggregation": null,
      "sort_by": null,
      "show_legend": true,
      "show_grid": true,
      "refresh_interval": 300,
      "description": ""
    },
    {
      "id": "line_state_gaf",
      "title": "State GAF trend",
      "type": "line",
      "query": "SELECT STATE, YEAR, AVG(GAF) AS GAF FROM CMS_GAF_LOCALITY GROUP BY STATE, YEAR ORDER BY YEAR",
      "x_column": "YEAR",
      "y_column": "GAF",
      "dimensions": [],
      "measures": [],
      "filters": {},
      "color_scheme": "default",
      "height": 400,
      "width": 500,
      "aggregation": null,
      "sort_by": null,
      "show_legend": true,
      "show_grid": true,
      "refresh_interval": 300,
      "description": ""
    },
    {
      "id": "bar_localities",
      "title": "Locality GAF change",
      "type": "bar",
      "query": "SELECT STATE, LOCALITY_NAME, PCT_CHANGE FROM CMS_GAF_LOCALITY_CHANGE",
      "x_column": "PCT_CHANGE",
      "y_column": "LOCALITY_NAME",
      "dimensions": [],
      "measures": [],
      "filters": {},
      "color_scheme": "default",
      "height": 400,
      "width": 500,
      "aggregation": null,
      "sort_by": null,
      "show_legend": true,
      "show_grid": true,
      "refresh_interval": 300,
      "description": ""
    },
    {
      "id": "map_payment",
      "title": "Payment % change by state and procedure",
      "type": "heatmap",
      "query": "SELECT STATE, HCPCS, YEAR, AVG(PAYMENT) AS PAYMENT FROM CMS_PAYMENTS_LOCALITY GROUP BY STATE, HCPCS, YEAR",
      "x_column": "STATE",
      "y_column": "PAYMENT",
      "dimensions": [],
      "measures": [],
      "filters": {},
      "color_scheme": "default",
      "height": 400,
      "width": 500,
      "aggregation": null,
      "sort_by": null,
      "show_legend": true,
