      "refresh_interval": 300,
      "description": ""
    },
    {
      "id": "line_national_payment",
      "title": "National base payment by procedure",
      "type": "line",
      "query": "SELECT HCPCS, YEAR, MAX(NATIONAL_PAYMENT) AS NATIONAL_PAYMENT FROM CMS_PAYMENTS_LOCALITY GROUP BY HCPCS, YEAR",
      "x_column": "YEAR",
      "y_column": "NATIONAL_PAYMENT",
      "dimensions": [],
